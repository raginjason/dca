# Single source of truth for dev tool versions, used by install.sh in both the
# devcontainer and Claude cloud (see doc/adr/0004).
ADR_TOOLS_VERSION=3.0.0
SHELLCHECK_VERSION=0.11.0
SHFMT_VERSION=3.14.1
# Installed only where gh is missing (the devcontainer). Claude cloud ships its
# own proxy-configured gh, which is left alone and only reported by --check.
GH_VERSION=2.89.0
